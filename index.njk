---
layout: base.njk
title: Home
---
<h2 style="text-align: center">latest</h2>
<br>
<div class="posts">
  {% for post in collections.posts %}
    <article class="post-preview">
        <a href="{{ post.url }}">{{ post.data.title }}</a> - 
      <time datetime="{{ post.date }}">{{ post.date | dateToString }}</time>
      {% if post.data.subtitle %}
        <p style="margin-top: 4px">{{ post.data.subtitle }}</p>
      {% endif %}
    </article>
  {% endfor %}
</div>